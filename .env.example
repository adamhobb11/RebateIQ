# =====================================================================
# RebateIQ environment template
# Copy to .env and fill in real values. .env is gitignored — never commit it.
# =====================================================================

# --- Gemini / Google GenAI ---------------------------------------------------
# Local dev runs Vertex AI through gcloud Application Default Credentials (ADC):
#   gcloud auth login && gcloud auth application-default login
# No API key needed. NOTE: Gemini 3.x models on Vertex are served from the
# `global` endpoint only — regional locations return 404 model-not-found.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=rebateiq
GOOGLE_CLOUD_LOCATION=global

# Alternative (NOT recommended for this project): the AI Studio Developer-API
# path. It bills against AI Studio prepaid credits, which are depleted for this
# account and return 429 RESOURCE_EXHAUSTED. Kept only for reference:
# GOOGLE_GENAI_USE_VERTEXAI=false
# GOOGLE_API_KEY=your-gemini-api-key

# Default model for all agents (override per-agent later if needed).
# gemini-3.5-flash = fast/cheap workhorse; gemini-3.1-pro = heavy reasoning.
REBATEIQ_MODEL=gemini-3.5-flash

# --- Elasticsearch (Elastic Cloud Serverless, GCP us-central-1) --------------
# From your Elastic deployment: the endpoint URL and an API key.
ES_URL=https://your-deployment.es.us-central1.gcp.elastic.cloud:443
ES_API_KEY=your-base64-elastic-api-key

# Indices
ES_PROGRAMS_INDEX=rebate_programs
ES_LISTINGS_INDEX=business_listings

# --- Later phases (placeholders, not needed yet) ------------------------------
# SENDGRID_API_KEY=
# Google Calendar auth is handled via the Calendar MCP OAuth flow, not a key here.
